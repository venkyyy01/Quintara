# Copy to `.env` (server) or `apps/web/.env.local` (web) and adjust.

# ── Server ──────────────────────────────────────────────────────────────────
# HTTP + WebSocket port.
PORT=4000
# Bind address. Use 127.0.0.1 behind a reverse proxy; 0.0.0.0 in containers.
HOST=0.0.0.0
# Comma-separated list of allowed browser origins, or `true` for permissive
# (development only). Set this to your deployed web origin in production.
CORS_ORIGIN=http://localhost:3000
# HMAC secret used to sign player tokens. REQUIRED in production: without it a
# new ephemeral secret is generated on boot, which invalidates every token
# after a restart and prevents multi-instance deployments from agreeing.
# Generate one with: openssl rand -base64 48
# Leave empty for local development; never deploy a documented placeholder.
QUINTARA_AUTH_SECRET=

# Number of trusted reverse-proxy hops (or a comma-separated proxy IP list).
# Set this when the server is behind the reverse proxy described in README;
# leave unset when the server is directly exposed to the internet.
# TRUST_PROXY=1

# ── Web ─────────────────────────────────────────────────────────────────────
# WebSocket endpoint of the game server. Omit when the web app and server are
# served from the same origin (the client derives ws(s)://<origin>/ws).
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
# Public origin used for canonical URLs, sitemap and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
