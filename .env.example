# Copy to `.env` (server) or `apps/web/.env.local` (web) and adjust.

# ── Server ──────────────────────────────────────────────────────────────────
# HTTP + WebSocket port.
PORT=4000
# Bind address. Use 127.0.0.1 behind a reverse proxy; 0.0.0.0 in containers.
HOST=0.0.0.0
# Comma-separated list of allowed browser origins, or `true` for permissive
# (development only). Set this to your deployed web origin in production.
CORS_ORIGIN=http://localhost:3000
# HMAC secret used to sign player tokens. REQUIRED in production: without it a
# new ephemeral secret is generated on boot, which invalidates every token
# after a restart and prevents multi-instance deployments from agreeing.
# Generate one with: openssl rand -base64 48
# Leave empty for local development; never deploy a documented placeholder.
QUINTARA_AUTH_SECRET=

# Number of trusted reverse-proxy hops (or a comma-separated proxy IP list).
# Set this when the server is behind the reverse proxy described in README;
# leave unset when the server is directly exposed to the internet.
# TRUST_PROXY=1

# ── Web ─────────────────────────────────────────────────────────────────────
# WebSocket endpoint of the game server. Omit when the web app and server are
# served from the same origin (the client derives ws(s)://<origin>/ws).
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
# Public origin used for canonical URLs, sitemap and Open Graph metadata.
# Resolved in this order: NEXT_PUBLIC_SITE_URL -> VERCEL_PROJECT_PRODUCTION_URL
# -> VERCEL_URL -> http://localhost:3000. Set this to a domain you own before
# any public deployment; it never defaults to an unowned domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public contact address shown on the privacy and terms pages. Required for a
# production deployment: the app fails fast if it is missing rather than
# publishing a privacy policy with no monitored contact channel. Set this
# together with NEXT_PUBLIC_SITE_URL; an unset site URL is treated as a local
# build, so do not rely on the guard alone.
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Static demo (GitHub Pages) ──────────────────────────────────────────────
# Prefix when the exported site is served from a subpath, e.g. /Quintara.
# Leave empty at a domain root.
# NEXT_PUBLIC_BASE_PATH=/Quintara
# Build a frontend-only demo: the online lobby explains that the authoritative
# game server is not attached to this deployment.
# NEXT_PUBLIC_DEMO_MODE=1
# Build-time flag: emit a static export with trailing-slash routes.
# NEXT_STATIC_EXPORT=1
